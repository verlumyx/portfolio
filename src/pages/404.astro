---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/lib/profile";
import Icon from "@/components/Icon.astro";
---

<Layout
  title={`404: Página no encontrada — ${profile.name}`}
  description="La página que buscas no existe o ha sido movida."
>
  <main class="flex min-h-screen flex-col items-center justify-center px-6 py-24 text-center">
    <span class="rounded-full bg-accent-soft px-3 py-1 font-mono text-xs font-medium text-accent">
      Error 404
    </span>
    <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-6xl">
      Página no encontrada
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-muted">
      La ruta que intentas acceder no existe, fue renombrada o ya no está disponible.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-11 items-center gap-2 rounded-full bg-accent px-6 text-sm font-medium text-white transition-colors hover:bg-accent-strong"
      >
        <span>Volver al inicio</span>
        <Icon name="arrow-up-right" />
      </a>
      <a
        href="/#proyectos"
        class="inline-flex h-11 items-center gap-2 rounded-full border border-border px-6 text-sm font-medium transition-colors hover:border-foreground"
      >
        <span>Explorar proyectos</span>
      </a>
    </div>
  </main>
</Layout>
