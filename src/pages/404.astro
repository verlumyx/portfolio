---
import Layout from "@/layouts/Layout.astro";
import { profile, projects, navLinks } from "@/lib/profile";
import Icon from "@/components/Icon.astro";

// Searchable items for internal search
const searchableItems = [
  ...navLinks.map((l) => ({
    title: l.label,
    subtitle: "Sección del portafolio",
    url: `/${l.href}`,
  })),
  ...projects.map((p) => ({
    title: p.title,
    subtitle: `Proyecto · ${p.tags.slice(0, 3).join(", ")}`,
    url: `/proyectos/${p.slug}`,
  })),
];
---

<Layout
  title={`404: Página no encontrada — ${profile.name}`}
  description="Página no encontrada en el portafolio de Gibmyx Gomez. Explora proyectos de desarrollo web full stack con Laravel, React y soluciones prácticas con IA."
>
  <main class="flex min-h-screen flex-col items-center justify-center px-6 py-20 text-center">
    <div class="mx-auto w-full max-w-lg">
      <span class="inline-block rounded-full bg-accent-soft px-3.5 py-1 font-mono text-xs font-semibold text-accent">
        Error 404
      </span>

      <h1 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
        Página no encontrada
      </h1>

      <p class="mt-4 text-base leading-relaxed text-muted">
        La ruta que buscas no existe o ha sido movida. Puedes usar el buscador a continuación para encontrar proyectos y secciones, o regresar al inicio.
      </p>

      {/* Buscador interno */}
      <div class="mt-8 text-left">
        <label for="search-input" class="sr-only">Buscar en el sitio</label>
        <div class="relative">
          <input
            id="search-input"
            type="search"
            placeholder="Buscar proyectos, secciones o tecnologías..."
            class="w-full rounded-2xl border border-border bg-surface px-4 py-3 pl-11 text-sm text-foreground placeholder:text-subtle focus:border-accent focus:outline-hidden focus:ring-1 focus:ring-accent"
          />
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-subtle">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </div>
        </div>

        {/* Resultados de búsqueda dinámica */}
        <ul
          id="search-results"
          class="mt-3 max-h-60 overflow-y-auto divide-y divide-border rounded-2xl border border-border bg-background"
        >
          {searchableItems.map((item) => (
            <li data-search-item data-search-text={`${item.title} ${item.subtitle}`.toLowerCase()}>
              <a
                href={item.url}
                class="flex items-center justify-between p-3.5 text-sm transition-colors hover:bg-surface hover:text-accent"
              >
                <div>
                  <p class="font-medium text-foreground">{item.title}</p>
                  <p class="text-xs text-subtle">{item.subtitle}</p>
                </div>
                <Icon name="arrow-up-right" class="shrink-0 text-subtle" />
              </a>
            </li>
          ))}
        </ul>
        <p id="no-results" class="hidden mt-3 p-4 text-center text-sm text-muted">
          No se encontraron resultados para tu búsqueda.
        </p>
      </div>

      {/* Acciones principales */}
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex h-11 items-center gap-2 rounded-full bg-accent px-6 text-sm font-medium text-white transition-colors hover:bg-accent-strong"
        >
          <span>Volver al inicio</span>
          <Icon name="arrow-up-right" />
        </a>
        <a
          href="/#proyectos"
          class="inline-flex h-11 items-center gap-2 rounded-full border border-border px-6 text-sm font-medium transition-colors hover:border-foreground"
        >
          <span>Ver proyectos</span>
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  function setupSearch() {
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const items = document.querySelectorAll("[data-search-item]");
    const noResults = document.getElementById("no-results");

    if (!input) return;

    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let matches = 0;

      items.forEach((el) => {
        const text = el.getAttribute("data-search-text") || "";
        const match = q === "" || text.includes(q);
        (el as HTMLElement).style.display = match ? "" : "none";
        if (match) matches++;
      });

      if (noResults) {
        noResults.classList.toggle("hidden", matches > 0);
      }
    });
  }

  setupSearch();
  document.addEventListener("astro:page-load", setupSearch);
</script>
