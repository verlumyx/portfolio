---
import Layout from "@/layouts/Layout.astro";
import { profile, projects } from "@/lib/profile";
import Icon from "@/components/Icon.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const currentYear = new Date().getFullYear();
---

<Layout
  title={`${project.title} — Arquitectura y Detalles | ${profile.name}`}
  description={project.description}
  ogType="article"
>
  <div class="min-h-screen bg-background text-foreground">
    {/* Top navigation */}
    <header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
        <a
          href="/#proyectos"
          class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-foreground"
        >
          <span class="transition-transform group-hover:-translate-x-1">←</span>
          <span>Volver al portafolio</span>
        </a>

        <div class="flex items-center gap-3">
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-border px-3.5 py-1.5 text-xs font-medium transition-colors hover:border-foreground"
          >
            <Icon name="github" class="h-4 w-4" />
            <span>GitHub</span>
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    {/* Main Content */}
    <main class="mx-auto w-full max-w-5xl px-6 py-12 md:py-16">
      {/* Project Header */}
      <section class="border-b border-border pb-12 md:pb-16">
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span
            class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs font-medium ${
              project.status === "Completado"
                ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                : "bg-amber-500/10 text-amber-600 dark:text-amber-400"
            }`}
          >
            <span
              class={`h-2 w-2 rounded-full ${
                project.status === "Completado"
                  ? "bg-emerald-500"
                  : "bg-amber-500 animate-pulse"
              }`}
            ></span>
            {project.status}
          </span>

          <span class="font-mono text-xs text-subtle">
            Desarrollado por {profile.name}
          </span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight md:text-6xl">
          {project.title}
        </h1>

        <p class="mt-4 text-xl font-medium leading-relaxed text-muted md:text-2xl">
          {project.tagline}
        </p>

        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted md:text-lg">
          {project.description}
        </p>

        {/* Action buttons */}
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center gap-2 rounded-full bg-accent px-6 text-sm font-medium text-white transition-colors hover:bg-accent-strong"
          >
            <Icon name="github" />
            <span>Ver repositorio en GitHub</span>
            <Icon name="arrow-up-right" />
          </a>

          {project.secondaryGithubUrl && (
            <a
              href={project.secondaryGithubUrl.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center gap-2 rounded-full border border-border bg-surface px-6 text-sm font-medium transition-colors hover:border-foreground"
            >
              <Icon name="github" />
              <span>{project.secondaryGithubUrl.label}</span>
              <Icon name="arrow-up-right" />
            </a>
          )}

          {project.liveUrl && (
            <a
              href={project.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center gap-2 rounded-full border border-border px-6 text-sm font-medium transition-colors hover:border-foreground"
            >
              <span>Ver demo en vivo</span>
              <Icon name="arrow-up-right" />
            </a>
          )}
        </div>

        {/* Tags */}
        <div class="mt-10">
          <p class="mb-3 font-mono text-xs uppercase tracking-wider text-subtle">
            Tecnologías clave
          </p>
          <ul class="flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <li
                class="rounded-md bg-accent-soft px-2.5 py-1 font-mono text-xs text-accent"
              >
                {t}
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* System Architecture */}
      <section class="border-b border-border py-12 md:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
          Ingeniería &amp; Diseño
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
          Arquitectura del Sistema
        </h2>

        <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted">
          {project.architecture.summary}
        </p>

        {project.architecture.diagram && (
          <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-surface/80 p-4 md:p-6">
            <div class="mb-3 flex items-center justify-between border-b border-border/60 pb-3">
              <span class="font-mono text-xs text-subtle">
                Diagrama de flujo &amp; topología
              </span>
              <span class="font-mono text-xs text-accent">
                {project.slug}.architecture
              </span>
            </div>
            <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-foreground md:text-sm">
              <code>{project.architecture.diagram}</code>
            </pre>
          </div>
        )}

        <div class="mt-8">
          <h3 class="text-lg font-semibold tracking-tight">
            Puntos clave de la arquitectura
          </h3>
          <ul class="mt-4 space-y-3">
            {project.architecture.keyPoints.map((point) => (
              <li
                class="flex items-start gap-3 text-[15px] leading-relaxed text-muted"
              >
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* Tech Stack Breakdown */}
      <section class="border-b border-border py-12 md:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
          Ecosistema
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
          Stack Tecnológico Detallado
        </h2>

        <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-surface/40">
          <div class="grid grid-cols-1 divide-y divide-border md:grid-cols-3 md:divide-x md:divide-y-0">
            {project.techStack.map((item) => (
              <div class="p-6">
                <span class="font-mono text-xs uppercase tracking-wider text-accent">
                  {item.layer}
                </span>
                <h3 class="mt-2 text-base font-semibold tracking-tight text-foreground">
                  {item.tech}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  {item.purpose}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Key Features */}
      <section class="border-b border-border py-12 md:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
          Capacidades
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
          Características Principales
        </h2>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {project.features.map((feature, idx) => (
            <div
              class="flex items-start gap-3.5 rounded-xl border border-border bg-background p-5 transition-colors hover:border-accent/40 hover:bg-surface"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-soft font-mono text-xs font-semibold text-accent">
                {idx + 1}
              </span>
              <p class="text-sm leading-relaxed text-muted">
                {feature}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* Creation notes / Engineering decisions */}
      <section class="py-12 md:py-16">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">
          Decisiones de Ingeniería
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
          ¿Cómo se creó este proyecto?
        </h2>

        <div class="mt-6 space-y-4">
          {project.creationNotes.map((note) => (
            <p
              class="rounded-xl border border-border/80 bg-surface/50 p-5 text-base leading-relaxed text-muted"
            >
              {note}
            </p>
          ))}
        </div>

        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-border bg-surface p-8">
          <div>
            <h3 class="text-lg font-semibold tracking-tight">
              ¿Quieres revisar el código fuente completo?
            </h3>
            <p class="mt-1 text-sm text-muted">
              El repositorio público contiene el historial de commits, pruebas e instrucciones de ejecución.
            </p>
          </div>
          <a
            href={project.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center gap-2 rounded-full bg-accent px-6 text-sm font-medium text-white transition-colors hover:bg-accent-strong"
          >
            <Icon name="github" />
            <span>Explorar en GitHub</span>
            <Icon name="arrow-up-right" />
          </a>
        </div>
      </section>
    </main>

    {/* Detail Footer */}
    <footer class="border-t border-border py-8 text-center text-xs text-muted">
      <div class="mx-auto max-w-5xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {currentYear} {profile.name}. Todos los derechos reservados.</p>
        <a
          href="/#proyectos"
          class="text-muted hover:text-foreground transition-colors"
        >
          ← Volver a todos los proyectos
        </a>
      </div>
    </footer>
  </div>
</Layout>
