---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Cambiar tema"
  class={`inline-flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors hover:border-accent hover:text-accent ${className}`}
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    class="theme-sun h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>

  <!-- Moon icon (shown in light mode) -->
  <svg
    class="theme-moon h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  :global(html.dark) .theme-sun {
    display: block;
  }
  :global(html.dark) .theme-moon {
    display: none;
  }
  :global(html:not(.dark)) .theme-sun {
    display: none;
  }
  :global(html:not(.dark)) .theme-moon {
    display: block;
  }
</style>

<script>
  function initThemeToggle() {
    const buttons = document.querySelectorAll("[data-theme-toggle]");
    buttons.forEach((btn) => {
      if (btn.hasAttribute("data-theme-listener")) return;
      btn.setAttribute("data-theme-listener", "true");

      btn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {}
      });
    });
  }

  initThemeToggle();
  document.addEventListener("astro:after-swap", initThemeToggle);
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
