---
import { certifications, education, languages } from "@/lib/profile";
import Section from "./Section.astro";
---

<Section id="formacion" eyebrow="05 — Formación" title="Educación y cursos">
  <div class="grid gap-12 md:grid-cols-5">
    <div class="space-y-12 md:col-span-2">
      <div>
        <p class="mb-4 text-sm font-medium">Educación</p>
        <h3 class="text-xl font-semibold tracking-tight">
          {education.degree}
        </h3>
        <p class="mt-1 text-muted">{education.institution}</p>
        <span class="mt-3 inline-block rounded-md bg-accent-soft px-2 py-1 font-mono text-xs text-accent">
          {education.status}
        </span>
      </div>

      <div>
        <p class="mb-4 text-sm font-medium">Idiomas</p>
        <ul class="space-y-2">
          {languages.map((l) => (
            <li class="flex justify-between gap-4 text-[15px]">
              <span>{l.name}</span>
              <span class="text-muted">{l.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="md:col-span-3">
      <p class="mb-4 text-sm font-medium">Cursos y certificaciones</p>
      <ul class="divide-y divide-border border-y border-border">
        {certifications.map((c) => (
          <li class="flex items-baseline justify-between gap-6 py-4">
            <div>
              <p class="text-[15px]">{c.title}</p>
              <p class="mt-0.5 text-sm text-subtle">{c.issuer}</p>
            </div>
            <span class="font-mono text-xs text-subtle">{c.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
