---
import { experience } from "@/lib/profile";
import Section from "./Section.astro";
---

<Section id="experiencia" eyebrow="02 — Experiencia" title="Trayectoria">
  <ol class="relative border-l border-border">
    {experience.map((job) => (
      <li class="pb-14 pl-8 last:pb-0 md:pl-12">
        <span
          class={`absolute -left-[5px] mt-2 h-[9px] w-[9px] rounded-full ${
            job.current ? "bg-accent" : "bg-border"
          }`}
        ></span>
        <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
          <div>
            <h3 class="text-xl font-semibold tracking-tight">
              {job.role}
            </h3>
            <p class="mt-1 font-medium text-accent">{job.company}</p>
          </div>
          <p class="font-mono text-xs uppercase tracking-wider text-subtle">
            {job.period}
          </p>
        </div>

        {job.description && (
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {job.description}
          </p>
        )}

        <ul class="mt-5 space-y-3">
          {job.bullets.map((b) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-muted">
              <span class="mt-[11px] h-px w-3 shrink-0 bg-accent"></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>

        {job.subProjects && job.subProjects.length > 0 && (
          <div class="mt-8 rounded-2xl border border-border bg-surface/50 p-5 md:p-6">
            {job.subProjectsSectionTitle && (
              <div class="mb-4 flex items-center gap-2 border-b border-border/80 pb-3">
                <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">
                  {job.subProjectsSectionTitle}
                </h4>
              </div>
            )}
            <div class="space-y-4">
              {job.subProjects.map((sub) => (
                <div class="rounded-xl border border-border/80 bg-background/80 p-4 transition-all hover:border-accent/40">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                    <h5 class="text-base font-semibold tracking-tight text-foreground">
                      {sub.title}
                    </h5>
                    {sub.period && (
                      <span class="inline-flex w-fit items-center rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[11px] font-medium text-subtle">
                        {sub.period}
                      </span>
                    )}
                  </div>
                  <p class="mt-1 font-mono text-xs text-accent">
                    {sub.tech}
                  </p>
                  <ul class="mt-3 space-y-2">
                    {sub.bullets.map((sb) => (
                      <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                        <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-accent/70"></span>
                        <span>{sb}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}
      </li>
    ))}
  </ol>
</Section>

